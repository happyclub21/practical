Cell[TextData[{
 "Question 2\nSolve the Cauchy problem ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["u", "x"], "+", 
      SubscriptBox["u", "y"]}], "=", "1"}], ",", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", 
     SuperscriptBox["x", "2"], " "}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "11c8f463-18e3-6149-9673-36ddc5056197"],
 "and plot the solution also."
}], "Text",
 CellChangeTimes->{{4.003105649278919*^9, 4.003105651552944*^9}, {
  4.003198291303501*^9, 4.0031983129324265`*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"e6f013a9-2b4e-a24f-8de2-b43ffb92a0a7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pde", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "+", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}], "==", "1"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pde", ",", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "0"}], "]"}], "==", 
        SuperscriptBox["x", "2"]}]}], "}"}], ",", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Solution of given cauchy problem is : \>\"", ",", "sol"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "/.", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.0031056733235207`*^9, 4.003105704634346*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"c0bad9f8-0b3d-484f-9c49-12e7ad946957"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Solution of given cauchy problem is : \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "\[Rule]", 
      RowBox[{
       SuperscriptBox["x", "2"], "+", "y", "-", 
       RowBox[{"2", " ", "x", " ", "y"}], "+", 
       SuperscriptBox["y", "2"]}]}], "}"}], "}"}]}],
  SequenceForm[
  "Solution of given cauchy problem is : ", {{$CellContext`u[$CellContext`x, \
$CellContext`y] -> $CellContext`x^2 + $CellContext`y - 
      2 $CellContext`x $CellContext`y + $CellContext`y^2}}],
  Editable->False]], "Print",
 CellChangeTimes->{4.0031057073761673`*^9, 4.003205227032423*^9},
 CellLabel->
  "During evaluation of \
In[68]:=",ExpressionUUID->"97a42cf6-3ada-0a4f-807a-5120247f8428"],

