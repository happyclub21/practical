Cell[TextData[StyleBox["The traffic density function \[Rho](x,t) or the \
solution for the given initial value problem are given by: ",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{
  4.0031953838935223`*^9},ExpressionUUID->"a893fee3-5792-a54e-9dc2-\
7d4ffb2497e2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqn2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "+", 
     RowBox[{
      RowBox[{"Exp", "[", "t", "]"}], "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}], ",", "x"}], "]"}]}]}], "==", 
    RowBox[{"2", "*", 
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "t"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol2", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eqn2", ",", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "==", 
       RowBox[{"1", "+", 
        RowBox[{
         RowBox[{"Sin", "[", "x", "]"}], "*", 
         RowBox[{"Sin", "[", "x", "]"}]}]}]}]}], "}"}], ",", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "t"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.0031954165312004`*^9, 4.003195472322935*^9}, {
  4.003195529993389*^9, 4.003195530128666*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"b081ba73-e33a-bd43-99e1-b7f2703d21b0"],

Cell[BoxData[
 TemplateBox[{
  "DSolve", "ifun", 
   "\"Inverse functions are being used by DSolve, so some solutions may not \
be found.\"", 2, 33, 10, 18230022286214421954, "Local"},
  "MessageTemplate",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{4.0031954773862953`*^9, 4.003195541707062*^9},
 CellLabel->
  "During evaluation of \
In[32]:=",ExpressionUUID->"64f87e71-c5eb-3b4e-a74b-8c7067058d30"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "\[Rule]", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"2", " ", "t"}]], " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SuperscriptBox[
        RowBox[{"Sin", "[", 
         RowBox[{"1", "-", 
          SuperscriptBox["\[ExponentialE]", "t"], "+", "x"}], "]"}], "2"]}], 
      ")"}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{4.0031954773991795`*^9, 4.0031955417165813`*^9},
 CellLabel->"Out[33]=",ExpressionUUID->"9011662e-b03b-5b4e-9739-109d18f6ea20"]
}, Open  ]],

Cell[TextData[StyleBox["Hence \[Rho](x,t) is the traffic density function of \
the given initial value problem.",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{
  4.0031954902756023`*^9},ExpressionUUID->"506fe270-0dd5-d14a-b7a8-\
ff033ea9508a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "sol2"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Traffic density function\>\""}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{4.0031955088456287`*^9, 4.003195519120796*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"ac30da96-3841-d443-b65d-dbdaed89a90c"],

