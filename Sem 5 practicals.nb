Cell[TextData[{
 "Question 5\nPlot the characteristics for the first order PDE : ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["xu", "x"], "+", 
     SubscriptBox["yu", "y"]}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "515634a9-5da4-8c4a-9605-357d2f98862f"]
}], "Text",
 CellChangeTimes->{{4.0031079579458714`*^9, 4.003107963185669*^9}, {
  4.003199264108036*^9, 4.0031992841849823`*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"44fe98ce-ca25-bd4f-836d-eb7f38455aa6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pde", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}]}], "+", 
     RowBox[{"y", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}]}], "==", "0"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{"pde", ",", 
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.003107986650696*^9, 4.0031079957512665`*^9}},
 CellLabel->"In[75]:=",ExpressionUUID->"79154597-6e5a-6449-9e77-9f8ed51b2381"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "\[Rule]", 
    RowBox[{
     TemplateBox[{"1"},
      "C"], "[", 
     FractionBox["y", "x"], "]"}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{4.0031080029882793`*^9},
 CellLabel->"Out[76]=",ExpressionUUID->"edf3f41b-a229-1245-ace8-dd59f4c2deb3"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f0", "=", 
   RowBox[{"ContourPlot3D", "[", 
    RowBox[{"u", ",", 
     RowBox[{"{", 
      RowBox[{"u", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"y", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "250"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x-axis\>\"", ",", "\"\<y-axis\>\"", 
        ",", "\"\<u-axis\>\""}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f1", "=", 
   RowBox[{"ContourPlot3D", "[", 
    RowBox[{
     RowBox[{"y", "/", "x"}], ",", 
     RowBox[{"{", 
      RowBox[{"u", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0.1", ",", "0.5"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"y", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "250"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x-axis\>\"", ",", "\"\<y-axis\>\"", 
        ",", "\"\<u-axis\>\""}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"f0", ",", "f1"}], "]"}]}], "Input",
 CellChangeTimes->{{4.003108035465639*^9, 4.003108070627554*^9}},
 CellLabel->"In[77]:=",ExpressionUUID->"adb8385d-d8fb-bc4c-89c5-6e944b2e8895"],

