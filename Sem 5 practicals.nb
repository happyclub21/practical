Cell[TextData[{
 "Question 6 \nSolve the Cauchy problem ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", 
         SuperscriptBox["x", "2"]}], ")"}], 
       SubscriptBox["u", "x"]}], "+", 
      SubscriptBox["xu", "y"]}], "=", "0"}], ",", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"0", ",", "y"}], ")"}], "=", "y"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f6d698d2-5def-754f-8649-20e2a9319ad2"],
 " and plot the solution also."
}], "Text",
 CellChangeTimes->{{4.003106388742861*^9, 4.0031064023218327`*^9}, {
  4.0031986237547817`*^9, 4.003198709145653*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"d40f7c49-87fb-234a-9841-72abe5dbf81e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pde", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        SuperscriptBox["x", "2"]}], ")"}], "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}]}], "+", 
     RowBox[{"x", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}]}], "==", "0"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pde", ",", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"0", ",", "y"}], "]"}], "==", "y"}]}], "}"}], ",", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Solution of given cauchy problem is : \>\"", ",", "sol"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "/.", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.0031064159180984`*^9, 4.0031064617098083`*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"0f0a97d4-2fc5-7f4e-b602-2ae0138c8546"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Solution of given cauchy problem is : \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "\[Rule]", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "y"}], "-", 
         RowBox[{"Log", "[", 
          RowBox[{"1", "+", 
           SuperscriptBox["x", "2"]}], "]"}]}], ")"}]}]}], "}"}], "}"}]}],
  SequenceForm[
  "Solution of given cauchy problem is : ", {{$CellContext`u[$CellContext`x, \
$CellContext`y] -> 
     Rational[1, 2] (2 $CellContext`y - Log[1 + $CellContext`x^2])}}],
  Editable->False]], "Print",
 CellChangeTimes->{4.0031064641001625`*^9},
 CellLabel->
  "During evaluation of \
In[43]:=",ExpressionUUID->"db38cdc8-eaab-1a43-927d-f346e7993a91"],

