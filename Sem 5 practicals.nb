Cell[TextData[{
 "Question 8\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["u", "tt"], "=", 
     RowBox[{"9", 
      SubscriptBox["u", "xx"]}]}], ",", " ", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", 
     SuperscriptBox["x", "3"]}], ",", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["u", "t"], "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", 
     RowBox[{"xCos", "[", "x", "]"}]}], ",", " ", 
    RowBox[{"x", "\[Element]", "R"}], " ", ",", 
    RowBox[{"t", ">", "0"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b3485638-c4fc-be43-bac4-07f3191366b0"]
}], "Text",
 CellChangeTimes->{{4.003110783343218*^9, 4.003110787810955*^9}, {
  4.003201194465969*^9, 4.0032012148351345`*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"303ce5e0-97cf-0e4e-9f9d-f83c32aad28b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "==", 
    RowBox[{"9", "*", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}]}], ",", 
   RowBox[{"u", "[", 
    RowBox[{"x", ",", "t"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "t"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"da", "[", 
   RowBox[{"c_", ",", "f_", ",", "g_", ",", "x_", ",", "t_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"1", "/", "2"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"f", "/.", 
        RowBox[{"x", "->", 
         RowBox[{"x", "+", 
          RowBox[{"c", "*", "t"}]}]}]}], ")"}], "+", 
      RowBox[{"(", 
       RowBox[{"f", "/.", 
        RowBox[{"x", "->", 
         RowBox[{"x", "-", 
          RowBox[{"c", "*", "t"}]}]}]}], ")"}]}], ")"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", "*", "c"}], ")"}]}], ")"}], "*", 
    RowBox[{"Integrate", "[", 
     RowBox[{"g", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"x", "-", 
         RowBox[{"c", "*", "t"}]}], ",", 
        RowBox[{"x", "+", 
         RowBox[{"c", "*", "t"}]}]}], "}"}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"da", "[", 
  RowBox[{"3", ",", 
   SuperscriptBox["x", "3"], ",", 
   RowBox[{"x", "*", 
    RowBox[{"Cos", "[", "x", "]"}]}], ",", "x", ",", "t"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{"%", ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "1", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"t", ",", "x", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.003110800028162*^9, 4.0031108433243904`*^9}},
 CellLabel->
  "In[114]:=",ExpressionUUID->"20e3eb73-7de0-5049-91de-2a8fea2b627b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{
      TemplateBox[{"1"},
       "C"], "[", 
      RowBox[{"t", "-", 
       FractionBox["x", "3"]}], "]"}], "+", 
     RowBox[{
      TemplateBox[{"2"},
       "C"], "[", 
      RowBox[{"t", "+", 
       FractionBox["x", "3"]}], "]"}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{4.003110856030012*^9},
 CellLabel->
  "Out[114]=",ExpressionUUID->"1f976e9b-7545-b14d-b055-73e417ac7a4d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "3"}], " ", "t"}], "+", "x"}], ")"}], "3"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", " ", "t"}], "+", "x"}], ")"}], "3"]}], ")"}]}], "+", 
  RowBox[{
   FractionBox["1", "6"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"3", " ", "t"}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", " ", 
         RowBox[{"Cos", "[", "x", "]"}]}], "-", 
        RowBox[{"Sin", "[", "x", "]"}]}], ")"}]}], "+", 
     RowBox[{"6", " ", "t", " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"3", " ", "t"}], "]"}], " ", 
      RowBox[{"Sin", "[", "x", "]"}]}]}], ")"}]}]}]], "Output",
 CellChangeTimes->{4.003110856213604*^9},
 CellLabel->
  "Out[116]=",ExpressionUUID->"e6fa46d7-00de-844a-a1dd-c556d28fc1db"],

