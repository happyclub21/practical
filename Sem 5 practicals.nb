}, Open  ]],

Cell[TextData[StyleBox["The traffic density function \[Rho](x,t) or the \
solution for the given initial value problem are given by: ",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{4.0031957201817684`*^9, 4.0031957250027313`*^9}},
 FontSize->14,ExpressionUUID->"61a446e8-01b5-f443-9dd6-28d8d918696e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqn3", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "+", 
     RowBox[{"2", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}], ",", "x"}], "]"}]}]}], "==", "0"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol3", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eqn3", ",", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "==", 
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         SuperscriptBox["x", "2"]}], "]"}]}]}], "}"}], ",", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "t"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.0031957390039387`*^9, 4.0031957816868896`*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"a58c1fa4-2321-b04e-8fcc-047089b73e2e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "\[Rule]", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "4"}], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"t", "-", 
         FractionBox["x", "2"]}], ")"}], "2"]}]]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{4.003195810242752*^9},
 CellLabel->"Out[39]=",ExpressionUUID->"db33afd1-98fa-2c44-90a2-47b914b3acc6"]
}, Open  ]],

Cell[TextData[StyleBox["Hence \[Rho](x,t) is the traffic density function of \
the given initial value problem.",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{
  4.003195826331482*^9},ExpressionUUID->"cab786ad-5d62-9f43-b390-\
4a2551c44ccc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "sol3"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Traffic density function\>\""}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{4.003195843674471*^9, 4.0031958547439327`*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"d0693fa6-07d0-a74d-9ea7-4b1009edcedd"],

