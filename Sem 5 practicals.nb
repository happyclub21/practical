Cell[TextData[{
 StyleBox["Practical 5 ",
  FontFamily->"Britannic",
  FontSize->36,
  FontVariations->{"Underline"->True}],
 "\n",
 StyleBox["Solution of heat equation ",
  FontSize->18],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "t"], "=", 
    SubscriptBox["ku", "xx"]}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"7f176a26-e327-0a4b-b944-c0e6f6be0f6c"],
 StyleBox["  with initial conditions ",
  FontSize->18]
}], "Text",
 CellChangeTimes->{{4.0031108738858204`*^9, 
  4.003110959810913*^9}},ExpressionUUID->"b58c7a5d-f013-df4b-95e3-\
b8942e899507"],

Cell[TextData[{
 "Question 1\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["u", "t"], "=", 
     RowBox[{
      FractionBox["1", "2"], 
      SubscriptBox["u", "xx"]}]}], ",", " ", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", 
     RowBox[{
      SuperscriptBox["Sin", "2"], "x"}]}], ",", " ", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"0", ",", "t"}], ")"}], "=", "0"}], ",", " ", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"Pi", ",", "t"}], ")"}], "=", "0"}], ",", " ", 
    RowBox[{"0", "<", "x", "<", "Pi"}], ",", " ", 
    RowBox[{"t", ">", "0"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4619d57a-bc98-cb44-a4a8-3875f749dea3"]
}], "Text",
 CellChangeTimes->{{4.0031109763245754`*^9, 4.0031109794349613`*^9}, 
   4.0032018561858635`*^9, {4.0032019188916664`*^9, 4.003202028330778*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"cbe85c75-bbab-ae4d-8200-9048de166d0e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqn", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "==", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}], "*", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "0"}], "]"}], "==", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"Sin", "[", "x", "]"}], ")"}], "2"]}], ",", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"0", ",", "t"}], "]"}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"Pi", ",", "t"}], "]"}], "==", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{"eqn", ",", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "Pi"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "Pi"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "4"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"x", ",", "t", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.003110986818989*^9, 4.0031110181695805`*^9}, {
  4.0031110535016727`*^9, 4.003111286320076*^9}, {4.003111316951786*^9, 
  4.003111317696865*^9}},
 CellLabel->
  "In[127]:=",ExpressionUUID->"a9708f97-98ac-6442-b905-764385c77076"],

