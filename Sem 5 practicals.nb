Cell[TextData[{
 "Question 1 \nSolve the Cauchy problem ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["u", "x"], "+", 
      SubscriptBox["xu", "y"]}], "=", "y"}], ",", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"0", ",", "y"}], ")"}], "=", 
     SuperscriptBox["y", "2"], " "}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "07588bda-aaeb-9948-a12e-8e1d1636863b"],
 "and plot the solution also."
}], "Text",
 CellChangeTimes->{{4.0031052834144096`*^9, 4.0031053699119263`*^9}, {
  4.003105406697012*^9, 4.0031054113582478`*^9}, {4.0031980250554276`*^9, 
  4.003198094890011*^9}, {4.0031981738664665`*^9, 4.0031982555962315`*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"66d068b6-1d38-7e43-b2da-06744ae09193"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pde", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "+", 
     RowBox[{"x", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}]}], "==", "y"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pde", ",", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"0", ",", "y"}], "]"}], "==", 
        SuperscriptBox["y", "2"]}]}], "}"}], ",", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Solution of given cauchy problem is : \>\"", ",", "sol"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "/.", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.003105414969345*^9, 4.0031056263105545`*^9}},
 CellLabel->"In[64]:=",ExpressionUUID->"3404ba36-462b-de4b-b6eb-1e5592aeb1c4"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Solution of given cauchy problem is : \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "\[Rule]", 
      RowBox[{
       FractionBox["1", "12"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "4"}], " ", 
          SuperscriptBox["x", "3"]}], "+", 
         RowBox[{"3", " ", 
          SuperscriptBox["x", "4"]}], "+", 
         RowBox[{"12", " ", "x", " ", "y"}], "-", 
         RowBox[{"12", " ", 
          SuperscriptBox["x", "2"], " ", "y"}], "+", 
         RowBox[{"12", " ", 
          SuperscriptBox["y", "2"]}]}], ")"}]}]}], "}"}], "}"}]}],
  SequenceForm[
  "Solution of given cauchy problem is : ", {{$CellContext`u[$CellContext`x, \
$CellContext`y] -> 
     Rational[1, 12] ((-4) $CellContext`x^3 + 3 $CellContext`x^4 + 
       12 $CellContext`x $CellContext`y - 12 $CellContext`x^2 $CellContext`y + 
       12 $CellContext`y^2)}}],
  Editable->False]], "Print",
 CellChangeTimes->{4.003105630378212*^9, 4.003205223340456*^9},
