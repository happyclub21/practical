Cell[TextData[StyleBox["The traffic density function \[Rho](x,t) or the \
solution for the given initial value problem are given by: ",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{4.0031938636485577`*^9, 4.0031938676788673`*^9}, {
  4.0031948306711655`*^9, 
  4.0031948900210304`*^9}},ExpressionUUID->"3446987a-d7e8-b143-9e58-\
56ecac187521"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqn1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "+", 
     RowBox[{"x", "*", 
      RowBox[{"Sin", "[", "t", "]"}], "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}], ",", "x"}], "]"}]}]}], "==", "0"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol1", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eqn1", ",", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "==", 
       RowBox[{"1", "+", 
        FractionBox["1", 
         RowBox[{"1", "+", 
          SuperscriptBox["x", "2"]}]]}]}]}], "}"}], ",", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "t"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.003194902710699*^9, 4.0031950355233917`*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"4c815b47-f31b-cc4d-8709-d10ca0c6287e"],

Cell[BoxData[
 TemplateBox[{
  "DSolve", "ifun", 
   "\"Inverse functions are being used by DSolve, so some solutions may not \
be found.\"", 2, 24, 4, 18230022286214421954, "Local"},
  "MessageTemplate",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{4.003195043251116*^9},
 CellLabel->
  "During evaluation of \
In[23]:=",ExpressionUUID->"08e28c76-b6c4-224a-9e96-85e61e80db10"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "\[Rule]", 
    FractionBox[
     RowBox[{
      RowBox[{"2", " ", 
       SuperscriptBox["\[ExponentialE]", "2"]}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", " ", 
         RowBox[{"Cos", "[", "t", "]"}]}]], " ", 
       SuperscriptBox["x", "2"]}]}], 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", "2"], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", " ", 
         RowBox[{"Cos", "[", "t", "]"}]}]], " ", 
       SuperscriptBox["x", "2"]}]}]]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{4.00319504326614*^9},
 CellLabel->"Out[24]=",ExpressionUUID->"918d571e-34d7-2249-88c3-dfa0db7bfc54"]
}, Open  ]],

Cell[TextData[StyleBox["Hence \[Rho](x,t) is the traffic density function of \
the given initial value problem.",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{4.003195053094244*^9, 
  4.003195096857321*^9}},ExpressionUUID->"45edbad9-031d-1a47-ac50-\
2f74b29e9a80"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "sol1"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Traffic density function\>\""}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{4.0031951231306877`*^9, 4.003195184785034*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"9d543da2-dcf8-8449-8718-71159d8d2036"],

