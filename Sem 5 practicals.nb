Cell[TextData[{
 "Question 2 \nFind the traffic density \[Rho](x,t) satisfying ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Rho]", "t"], "+", 
      RowBox[{
       SuperscriptBox["e", "t"], 
       SubscriptBox["\[Rho]", "x"]}]}], "=", 
     RowBox[{"2", "\[Rho]"}]}], ","}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "111d04d6-7726-7e4f-8d95-5aeeb0752a25"],
 " with  initial condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Rho]", "0"], "(", "x", ")"}], "=", 
    RowBox[{"1", "+", 
     RowBox[{
      SuperscriptBox["Sin", "2"], "(", "x", ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "65f56105-b235-4d46-b34b-5bbbbc47e593"],
 " .\nPlot the characteristics base curves and the traffic density function."
}], "Text",
 CellChangeTimes->{{4.0031952051475067`*^9, 4.0031952088013954`*^9}, {
  4.0032043911768227`*^9, 4.0032044416623287`*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"932ba0c1-3f60-5747-8e2b-746cb3565748"],

Cell[TextData[StyleBox["The  Characteristic base curves for the given initial \
value problem are given by : ",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{
  4.003195227840578*^9},ExpressionUUID->"e4e31e7b-13bb-8e42-a62a-\
9a67454ec490"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"charBaseCurves2", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
       RowBox[{"Exp", "[", "t", "]"}]}], ",", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "==", "x0"}]}], "}"}], ",", 
    RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}]}]], "Input",
 CellChangeTimes->{{4.0031952464867992`*^9, 4.0031952605951824`*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"7437842b-d3ea-3143-b3aa-34e0dd7bded7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     SuperscriptBox["\[ExponentialE]", "t"], "+", "x0"}]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{4.0031952652014217`*^9},
 CellLabel->"Out[26]=",ExpressionUUID->"24147fd8-99e4-8947-947c-b6ddf68fdd31"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"tab", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], "/.", 
      RowBox[{"charBaseCurves2", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "/.", 
     RowBox[{"{", 
      RowBox[{"x0", "->", "k"}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "4", ",", "20", ",", "4"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", "tab", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
