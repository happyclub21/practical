Cell[TextData[{
 StyleBox["Practical 3",
  FontFamily->"Britannic",
  FontSize->36,
  FontVariations->{"Underline"->True}],
 StyleBox[" ",
  FontFamily->"Britannic",
  FontVariations->{"Underline"->True}],
 "\n",
 StyleBox["Plotting the characteristics for the first order partial \
differential equations",
  FontSize->18]
}], "Text",
 CellChangeTimes->{{4.0031066747016296`*^9, 4.0031067130549564`*^9}, {
  4.0031067431600475`*^9, 4.003106751480091*^9}, {4.0031990372681255`*^9, 
  4.003199037470049*^9}},ExpressionUUID->"47b485d9-b400-ad40-b6e8-\
664572c34505"],

Cell[TextData[{
 "Question 1 \nPlot the characteristics for the first order PDE : ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["u", "x"], "-", 
     SubscriptBox["u", "y"]}], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "95eab7c7-b0d3-ab4a-8195-31c65d6826f0"]
}], "Text",
 CellChangeTimes->{{4.0031067535259113`*^9, 4.0031067746017056`*^9}, {
  4.00319905638686*^9, 4.0031991151003304`*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"0553c96d-8218-fb42-be3e-d0c32ff25b57"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pde", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "-", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}], "==", "1"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{"pde", ",", 
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.003106810363716*^9, 4.0031068735300045`*^9}},
 CellLabel->"In[76]:=",ExpressionUUID->"0fb0a3f2-8fe8-9441-853d-b8a7c4adca63"],

Cell[BoxData[
 RowBox[{"{", 
