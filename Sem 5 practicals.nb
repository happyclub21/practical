Cell[TextData[StyleBox["The traffic density function \[Rho](x,t) or the \
solution for the given initial value problem are given by: ",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{
  4.0031960394573784`*^9},ExpressionUUID->"68befebd-2dfa-494c-95fa-\
88a33e8f6894"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqn4", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "+", 
     RowBox[{"2", "*", 
      SuperscriptBox["t", "2"], "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}], ",", "x"}], "]"}]}]}], "==", 
    RowBox[{
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "t"}], "]"}], "*", 
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "t"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol4", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eqn4", ",", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "==", 
       RowBox[{
        RowBox[{"Sin", "[", "x", "]"}], "*", 
        RowBox[{"Sin", "[", "x", "]"}]}]}]}], "}"}], ",", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "t"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.0031960585136356`*^9, 4.003196127815645*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"43060a79-1513-6141-b43e-2418091cc468"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "\[Rule]", 
    FractionBox["1", 
     RowBox[{
      RowBox[{"-", "t"}], "+", 
      SuperscriptBox[
       RowBox[{"Csc", "[", 
        RowBox[{
         FractionBox["1", "3"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "2"}], " ", 
            SuperscriptBox["t", "3"]}], "+", 
           RowBox[{"3", " ", "x"}]}], ")"}]}], "]"}], "2"]}]]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{4.003196132099964*^9},
 CellLabel->"Out[47]=",ExpressionUUID->"1f3c7aec-8350-d549-bd6d-f0368285bb72"]
}, Open  ]],

Cell[TextData[StyleBox["Hence \[Rho](x,t) is the traffic density function of \
the given initial value problem.",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{
  4.003196143653755*^9},ExpressionUUID->"26431e14-5d53-f844-b89c-\
e99723e975ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "sol4"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Traffic density function\>\""}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{4.0031961653454113`*^9, 4.0031961758651466`*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"abba6791-3112-da4e-9271-df055aa3fbad"],

