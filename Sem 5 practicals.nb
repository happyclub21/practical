Cell[TextData[{
 "Question  5 \nFind the traffic density \[Rho](x,t) satisfying ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Rho]", "t"], "+", 
      RowBox[{
       SuperscriptBox["t", "2"], "*", 
       RowBox[{"Cos", "(", "t", ")"}], 
       SubscriptBox["\[Rho]", "x"]}]}], "=", "5"}], ","}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ace5045c-4b42-4e4e-8e24-f89875c19999"],
 " with  initial condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Rho]", "0"], "(", "x", ")"}], "=", 
    RowBox[{"Exp", "[", "x", "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4ae8e353-ab93-8047-8280-8431d6c90bd6"],
 " .\nPlot the characteristics base curves and the traffic density function."
}], "Text",
 CellChangeTimes->{{4.0031962582389793`*^9, 4.0031962615004025`*^9}, {
  4.00320459183827*^9, 4.0032046491074734`*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"adf1944f-7aea-364a-803d-13467d3fe6d1"],

Cell[TextData[StyleBox["The  Characteristic base curves for the given initial \
value problem are given by : ",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{
  4.003196280338188*^9},ExpressionUUID->"f62c65d8-397b-bd40-86e8-\
8c8331b3a308"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"charBaseCurves5", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        SuperscriptBox["t", "2"], "*", 
        RowBox[{"Cos", "[", "t", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "==", "x0"}]}], "}"}], ",", 
    RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}]}]], "Input",
 CellChangeTimes->{{4.003196298740959*^9, 4.0031963207353497`*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"51351aa2-ce0a-ea43-8f83-48ff1589a0b7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
    RowBox[{"x0", "+", 
     RowBox[{"2", " ", "t", " ", 
      RowBox[{"Cos", "[", "t", "]"}]}], "-", 
     RowBox[{"2", " ", 
      RowBox[{"Sin", "[", "t", "]"}]}], "+", 
     RowBox[{
      SuperscriptBox["t", "2"], " ", 
      RowBox[{"Sin", "[", "t", "]"}]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{4.0031963248326225`*^9},
 CellLabel->"Out[49]=",ExpressionUUID->"8b972356-2575-e448-9328-9ea6cc0819d6"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"tab", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], "/.", 
      RowBox[{"charBaseCurves5", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "/.", 
     RowBox[{"{", 
      RowBox[{"x0", "->", "k"}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "5", ",", "20", ",", "5"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", "tab", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"Thickness", "[", "0.01", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"tab", "[", 
       RowBox[{"[", "i", "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "->", "\"\<Characteristic base curves\>\""}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{4.00319691384671*^9, 4.0031969543444824`*^9}},
 CellLabel->"In[50]:=",ExpressionUUID->"f35cc3ba-4e31-b647-89d7-f30fd28101f4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"5", "+", 
    RowBox[{"2", " ", "t", " ", 
     RowBox[{"Cos", "[", "t", "]"}]}], "-", 
    RowBox[{"2", " ", 
     RowBox[{"Sin", "[", "t", "]"}]}], "+", 
    RowBox[{
     SuperscriptBox["t", "2"], " ", 
     RowBox[{"Sin", "[", "t", "]"}]}]}], ",", 
   RowBox[{"10", "+", 
    RowBox[{"2", " ", "t", " ", 
     RowBox[{"Cos", "[", "t", "]"}]}], "-", 
    RowBox[{"2", " ", 
     RowBox[{"Sin", "[", "t", "]"}]}], "+", 
    RowBox[{
     SuperscriptBox["t", "2"], " ", 
     RowBox[{"Sin", "[", "t", "]"}]}]}], ",", 
   RowBox[{"15", "+", 
    RowBox[{"2", " ", "t", " ", 
     RowBox[{"Cos", "[", "t", "]"}]}], "-", 
    RowBox[{"2", " ", 
     RowBox[{"Sin", "[", "t", "]"}]}], "+", 
    RowBox[{
     SuperscriptBox["t", "2"], " ", 
     RowBox[{"Sin", "[", "t", "]"}]}]}], ",", 
   RowBox[{"20", "+", 
    RowBox[{"2", " ", "t", " ", 
     RowBox[{"Cos", "[", "t", "]"}]}], "-", 
    RowBox[{"2", " ", 
     RowBox[{"Sin", "[", "t", "]"}]}], "+", 
    RowBox[{
     SuperscriptBox["t", "2"], " ", 
     RowBox[{"Sin", "[", "t", "]"}]}]}]}], "}"}]], "Output",
 CellChangeTimes->{4.0031969610724106`*^9},
 CellLabel->"Out[50]=",ExpressionUUID->"ef726af6-9954-0746-a6c2-b2956312f8d0"],

