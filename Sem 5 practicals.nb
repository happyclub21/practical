 "Question 3\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["u", "tt"], "-", 
      RowBox[{"9", 
       SubscriptBox["u", "xx"]}]}], "=", "0"}], ",", " ", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", 
     RowBox[{
      SuperscriptBox["x", "3"], "(", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}], ")"}]}], ",", 
    RowBox[{
     RowBox[{
      SubscriptBox["u", "t"], "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", 
     SuperscriptBox["x", "2"]}], ",", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"0", ",", "t"}], ")"}], "=", 
     RowBox[{"0", " ", ":", "  ", 
      RowBox[{"0", "<", "x", "<", "1"}]}]}], ",", 
    RowBox[{
     RowBox[{"t", ">", "0"}], ";"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7dc897bb-640d-2347-8dda-add26d3953ad"]
}], "Text",
