Cell[TextData[{
 "Question 7\nSolve the Cauchy problem ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["u", "x"], "+", 
      RowBox[{"2", 
       SubscriptBox["xu", "y"]}]}], "=", 
     RowBox[{"2", "xu"}]}], ",", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", 
     SuperscriptBox["x", "2"], " "}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7c3e0920-7948-7d41-a5ae-333d3bee6e5e"],
 "and plot the solution also."
}], "Text",
 CellChangeTimes->{{4.003106480437128*^9, 4.00310648364159*^9}, {
  4.003198728904108*^9, 4.003198771122036*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"d50b9323-c24a-a74c-bb74-290d34f718e8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pde", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "+", 
     RowBox[{"2", "*", "x", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}]}], "==", 
    RowBox[{"2", "*", "x", "*", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "y"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pde", ",", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "0"}], "]"}], "==", 
        SuperscriptBox["x", "2"]}]}], "}"}], ",", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Solution of given cauchy problem is : \>\"", ",", "sol"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "/.", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.0031064937130184`*^9, 4.0031065480191593`*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"3dddb594-79a7-c348-80b0-4354289b8646"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Solution of given cauchy problem is : \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "\[Rule]", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", "y"]}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["x", "2"]}], "+", "y"}], ")"}]}]}], "}"}], "}"}]}],
  SequenceForm[
  "Solution of given cauchy problem is : ", {{$CellContext`u[$CellContext`x, \
$CellContext`y] -> -E^$CellContext`y (-$CellContext`x^2 + $CellContext`y)}}],
  Editable->False]], "Print",
 CellChangeTimes->{4.0031065497985077`*^9},
 CellLabel->
  "During evaluation of \
In[47]:=",ExpressionUUID->"0949526c-1605-fa49-81a5-486d3caaf51e"],

