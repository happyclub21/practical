   RowBox[{
    FractionBox["1", "3"], " ", 
    RowBox[{"(", 
     RowBox[{"9", "+", 
      RowBox[{"2", " ", 
       SuperscriptBox["t", "3"]}]}], ")"}]}], ",", 
