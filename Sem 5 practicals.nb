Cell[TextData[{
 "Question 4\nSolve the Cauchy problem y",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["u", "x"], "+", 
      SubscriptBox["xu", "y"]}], "=", "0"}], ",", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"0", ",", "y"}], ")"}], "=", 
     RowBox[{"Exp", "[", 
      RowBox[{"-", 
       SuperscriptBox["y", "2"]}], "]"}], "  "}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fea6de85-6b81-4246-beea-b015f11ed5ef"],
 "and plot the solution also."
}], "Text",
 CellChangeTimes->{{4.0031061942267056`*^9, 4.003106197909298*^9}, {
  4.0031983673759594`*^9, 4.0031984003673897`*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"869918fe-403d-164e-ae04-ad0b03ff2d64"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pde", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"y", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}]}], "+", 
     RowBox[{"x", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}]}], "==", "0"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pde", ",", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"0", ",", "y"}], "]"}], "==", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", 
          SuperscriptBox["y", "2"]}], "]"}]}]}], "}"}], ",", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Solution of given cauchy problem is : \>\"", ",", "sol"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "/.", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.003106214834692*^9, 4.0031062591520443`*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"d24273f4-4b52-f143-818e-2c45d81eb16d"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Solution of given cauchy problem is : \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "\[Rule]", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        SuperscriptBox["x", "2"], "-", 
        SuperscriptBox["y", "2"]}]]}], "}"}], "}"}]}],
  SequenceForm[
  "Solution of given cauchy problem is : ", {{$CellContext`u[$CellContext`x, \
$CellContext`y] -> E^($CellContext`x^2 - $CellContext`y^2)}}],
  Editable->False]], "Print",
 CellChangeTimes->{4.0031062612687416`*^9},
 CellLabel->
  "During evaluation of \
In[31]:=",ExpressionUUID->"a17e83b4-9ed1-eb46-8fef-1e670f6a153d"],

