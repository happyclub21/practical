Cell[TextData[{
 StyleBox["Practical 7 ",
  FontFamily->"Britannic",
  FontSize->36,
  FontVariations->{"Underline"->True}],
 "\n",
 StyleBox["Solution of traffic flow problem with given initial conditions, \
and plotting of the characteristic base curves and the traffic density \
function . ",
  FontSize->18]
}], "Text",
 CellChangeTimes->{{4.003194176034876*^9, 4.003194264427431*^9}, 
   4.0031942987559624`*^9},ExpressionUUID->"d4ef6e8a-dfd8-1e4d-b05b-\
3b20ff7fa0ac"],

Cell[TextData[{
 "Question 1 \nFind the traffic density \[Rho](x,t) satisfying ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Rho]", "t"], "+", 
      RowBox[{
       RowBox[{"xSin", "(", "t", ")"}], 
       SubscriptBox["\[Rho]", "x"]}]}], "=", "0"}], ","}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "241ec3e0-0313-6640-8806-451b7c52b353"],
 " with  initial condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Rho]", "0"], "(", "x", ")"}], "=", 
    RowBox[{"1", "+", 
     FractionBox["1", 
      RowBox[{"1", "+", 
       SuperscriptBox["x", "2"]}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7a0ec18e-fb5f-0f40-91f5-9884bdad9450"],
 " .\nPlot the characteristics base curves and the traffic density function."
}], "Text",
 CellChangeTimes->{{4.0031943035276146`*^9, 4.003194310983364*^9}, {
  4.003204162346348*^9, 4.003204345203184*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"491e6d42-d5b9-0448-b35f-84ff122d9c6c"],

Cell[TextData[StyleBox["The  Characteristic base curves for the given initial \
value problem are given by : ",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{4.0031947430759373`*^9, 
  4.0031948021228085`*^9}},ExpressionUUID->"5a46e738-5aea-c44e-b3fb-\
352efa8f8d21"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"charBaseCurves1", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"x", "[", "t", "]"}], "*", 
        RowBox[{"Sin", "[", "t", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "==", "x0"}]}], "}"}], ",", 
    RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}]}]], "Input",
 CellChangeTimes->{{4.0031943298957386`*^9, 4.0031944144086685`*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"f3f4b241-8526-494c-a452-38ea98d47cc7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"1", "-", 
       RowBox[{"Cos", "[", "t", "]"}]}]], " ", "x0"}]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{{4.00319440416432*^9, 4.0031944153058853`*^9}},
 CellLabel->"Out[20]=",ExpressionUUID->"fc4c3888-1e02-fe44-885c-26fe96c21955"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"tab", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], "/.", 
      RowBox[{"charBaseCurves1", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "/.", 
     RowBox[{"{", 
      RowBox[{"x0", "->", "k"}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "5", ",", "20", ",", "5"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", "tab", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"Thickness", "[", "0.01", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"tab", "[", 
       RowBox[{"[", "i", "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "->", "\"\<Characteristic base curves\>\""}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{4.003194488253689*^9, 4.0031946583672028`*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"9268d74a-e464-dc44-89e0-6cad6809b84e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"5", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"1", "-", 
      RowBox[{"Cos", "[", "t", "]"}]}]]}], ",", 
   RowBox[{"10", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"1", "-", 
      RowBox[{"Cos", "[", "t", "]"}]}]]}], ",", 
   RowBox[{"15", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"1", "-", 
      RowBox[{"Cos", "[", "t", "]"}]}]]}], ",", 
   RowBox[{"20", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"1", "-", 
      RowBox[{"Cos", "[", "t", "]"}]}]]}]}], "}"}]], "Output",
 CellChangeTimes->{4.0031946638661785`*^9},
 CellLabel->"Out[21]=",ExpressionUUID->"ddc8d4fb-5110-0d4b-b468-d25ea7f72eb9"],

