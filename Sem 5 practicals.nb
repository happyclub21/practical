Cell[TextData[{
 "Question 2 \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["u", "tt"], "=", 
     SubscriptBox["u", "xx"]}], ",", " ", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", 
     RowBox[{"Sin", "[", "x", "]"}]}], ",", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["u", "t"], "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", 
     RowBox[{"Cos", "[", "x", "]"}]}], ",", " ", 
    RowBox[{"x", "\[Element]", "R"}], " ", ",", 
    RowBox[{"t", ">", "0"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aa72fcce-e436-eb44-8adb-afd9fdf95a9d"]
}], "Text",
 CellChangeTimes->{{4.003109996270359*^9, 4.0031100036320076`*^9}, {
  4.0032009660244923`*^9, 4.003200987271549*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"f83392d8-b03f-fa44-99d1-300bc2689347"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "==", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}], ",", 
   RowBox[{"u", "[", 
    RowBox[{"x", ",", "t"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "t"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"da", "[", 
   RowBox[{"c_", ",", "f_", ",", "g_", ",", "x_", ",", "t_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"1", "/", "2"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"f", "/.", 
        RowBox[{"x", "->", 
         RowBox[{"x", "+", 
          RowBox[{"c", "*", "t"}]}]}]}], ")"}], "+", 
      RowBox[{"(", 
       RowBox[{"f", "/.", 
        RowBox[{"x", "->", 
         RowBox[{"x", "-", 
          RowBox[{"c", "*", "t"}]}]}]}], ")"}]}], ")"}]}], "+", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "c"}], ")"}]}], "*", 
    RowBox[{"Integrate", "[", 
     RowBox[{"g", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"x", "-", 
         RowBox[{"c", "*", "t"}]}], ",", 
        RowBox[{"x", "+", 
         RowBox[{"c", "*", "t"}]}]}], "}"}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"da", "[", 
  RowBox[{"1", ",", 
   RowBox[{"Sin", "[", "x", "]"}], ",", 
   RowBox[{"Cos", "[", "x", "]"}], ",", "x", ",", "t"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{"%", ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "1", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"t", ",", "x", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.003110036141781*^9, 4.003110074813673*^9}},
 CellLabel->"In[86]:=",ExpressionUUID->"4557d39c-ec76-2247-95a8-87328b856726"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{
      TemplateBox[{"1"},
       "C"], "[", 
      RowBox[{"t", "-", "x"}], "]"}], "+", 
     RowBox[{
      TemplateBox[{"2"},
       "C"], "[", 
      RowBox[{"t", "+", "x"}], "]"}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{4.003110080472727*^9},
 CellLabel->"Out[86]=",ExpressionUUID->"feb87266-fa56-464e-987a-00df386e2e5e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Cos", "[", "x", "]"}], " ", 
   RowBox[{"Sin", "[", "t", "]"}]}], "+", 
