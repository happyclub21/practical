Cell[TextData[{
 "Question 5\nSolve the Cauchy problem ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["u", "x"], "+", 
      RowBox[{"2", 
       SubscriptBox["u", "y"]}]}], "=", "0"}], ",", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", 
     RowBox[{"Sin", " ", "x", " "}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "82dffb2b-67a1-5441-83c1-80781f4f558a"],
 "and plot the solution also."
}], "Text",
 CellChangeTimes->{{4.0031062750789375`*^9, 4.0031062817782135`*^9}, {
  4.0031984155578136`*^9, 4.0031984412534657`*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"a5d1c8ce-0670-7143-bc32-b4bff3047d3d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pde", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "+", 
     RowBox[{"2", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}]}], "==", "0"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pde", ",", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "0"}], "]"}], "==", 
        RowBox[{"Sin", "[", "x", "]"}]}]}], "}"}], ",", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Solution of given cauchy problem is : \>\"", ",", "sol"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "/.", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.0031062913755817`*^9, 4.0031063583380814`*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"d774ff87-1854-084f-9348-efbb5dcde978"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Solution of given cauchy problem is : \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "\[Rule]", 
      RowBox[{"Sin", "[", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "x"}], "-", "y"}], ")"}]}], "]"}]}], "}"}], 
    "}"}]}],
  SequenceForm[
  "Solution of given cauchy problem is : ", {{$CellContext`u[$CellContext`x, \
$CellContext`y] -> Sin[Rational[1, 2] (2 $CellContext`x - $CellContext`y)]}}],
  Editable->False]], "Print",
 CellChangeTimes->{4.003106328660303*^9, 4.003106365114126*^9},
 CellLabel->
  "During evaluation of \
In[39]:=",ExpressionUUID->"fe3bdbc0-6bb2-f140-ada8-e4610a4a8707"],

