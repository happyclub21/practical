Cell[TextData[{
 "Question 3\nSolve the Cauchy problem ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["u", "x"], "+", 
      SubscriptBox["xu", "y"]}], "=", "0"}], ",", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"0", ",", "y"}], ")"}], "=", 
     RowBox[{"Sin", " ", "y", " "}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c7f4d519-98f5-8042-9c89-c982fde3aca9"],
 "and plot the solution also."
}], "Text",
 CellChangeTimes->{{4.0031057199886723`*^9, 4.003105728072136*^9}, {
  4.003106122685467*^9, 4.003106124481596*^9}, {4.003198320387497*^9, 
  4.003198342143055*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"d79165c3-c122-e44c-be46-2c29248eb72d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pde", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "+", 
     RowBox[{"x", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}]}], "==", "0"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pde", ",", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"0", ",", "y"}], "]"}], "==", 
        RowBox[{"Sin", "[", "y", "]"}]}]}], "}"}], ",", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Solution of given cauchy problem is : \>\"", ",", "sol"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "/.", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.003106140308836*^9, 4.003106182653307*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"3375a658-cb57-4547-a3a6-ada1f3fbd625"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Solution of given cauchy problem is : \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "\[Rule]", 
      RowBox[{"-", 
       RowBox[{"Sin", "[", 
        RowBox[{
         FractionBox[
          SuperscriptBox["x", "2"], "2"], "-", "y"}], "]"}]}]}], "}"}], 
    "}"}]}],
  SequenceForm[
  "Solution of given cauchy problem is : ", {{$CellContext`u[$CellContext`x, \
$CellContext`y] -> -Sin[Rational[1, 2] $CellContext`x^2 - $CellContext`y]}}],
  Editable->False]], "Print",
 CellChangeTimes->{4.003106185432913*^9},
 CellLabel->
  "During evaluation of \
In[27]:=",ExpressionUUID->"a2722f08-1c2f-0742-9857-09e71ab3c8a8"],

