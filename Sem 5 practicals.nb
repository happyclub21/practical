Cell[TextData[{
 StyleBox["Practical 6 ",
  FontFamily->"Britannic",
  FontSize->36,
  FontVariations->{"Underline"->True}],
 "\n",
 StyleBox["Solution of one-dimensional wave equation ",
  FontSize->18],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "tt"], "=", 
    RowBox[{
     SuperscriptBox["c", "2"], 
     SubscriptBox["u", "xx"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,
  FontSize->18,ExpressionUUID->"34fe05bc-f035-2b49-adfd-d1ca6b9240eb"],
 StyleBox[" with initial conditions:\n(i) ",
  FontSize->18],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"u", 
      RowBox[{"(", 
       RowBox[{"x", ",", "0"}], ")"}]}], "=", 
     RowBox[{"f", "(", "x", ")"}]}], ",", 
    RowBox[{
     RowBox[{
      SubscriptBox["u", "t"], "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", 
     RowBox[{
      RowBox[{"g", "(", "x", ")"}], ":", " ", 
      RowBox[{"x", "\[Element]", "R"}]}]}], ",", 
    RowBox[{"t", ">", "0"}]}], TraditionalForm]],
  FormatType->TraditionalForm,
  FontSize->18,ExpressionUUID->"7f3ee580-9c9c-f54c-9e98-930244634cdc"],
 StyleBox["\n(ii) ",
  FontSize->18],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"u", 
      RowBox[{"(", 
       RowBox[{"x", ",", "0"}], ")"}]}], "=", 
     RowBox[{"f", "(", "x", ")"}]}], ",", 
    RowBox[{
     RowBox[{
      SubscriptBox["u", "t"], "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", 
     RowBox[{"g", "(", "x", ")"}]}], ",", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"0", ",", "t"}], ")"}], "=", 
     RowBox[{"0", ":", " ", 
      RowBox[{"x", "\[Element]", "R"}]}]}], ",", 
    RowBox[{"t", ">", "0"}]}], TraditionalForm]],
  FormatType->TraditionalForm,
  FontSize->18,ExpressionUUID->"80eb13bb-c6d7-c740-a885-9a93ccf22c88"],
 StyleBox["\n(iii)",
  FontSize->18],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"u", 
      RowBox[{"(", 
       RowBox[{"x", ",", "0"}], ")"}]}], "=", 
     RowBox[{"f", "(", "x", ")"}]}], ",", 
    RowBox[{
     RowBox[{
      SubscriptBox["u", "t"], "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", 
     RowBox[{"g", "(", "x", ")"}]}], ",", 
    RowBox[{
     RowBox[{
      SubscriptBox["u", "x"], "(", 
      RowBox[{"0", ",", "t"}], ")"}], "=", 
     RowBox[{"0", ":", " ", 
      RowBox[{"x", "\[Element]", "R"}]}]}], ",", 
    RowBox[{"t", ">", "0"}]}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"34e263c4-ffc1-4248-b058-ed1b5cab35ce"]
}], "Text",
 CellChangeTimes->{{4.00319268084758*^9, 4.003192752896902*^9}, {
  4.0031931365483723`*^9, 
  4.0031933186515884`*^9}},ExpressionUUID->"e5f96dd2-5c11-3b48-bfa5-\
d5ff8a606a52"],

Cell[TextData[{
 "Question 1 \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["u", "tt"], "-", 
      SubscriptBox["u", "xx"]}], "=", "0"}], ",", " ", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", 
     RowBox[{"3", 
      RowBox[{"Sin", "[", "x", "]"}]}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["u", "t"], "(", 
       RowBox[{"x", ",", "0"}], ")"}], "=", 
      SuperscriptBox["x", "4"]}], ";", " ", 
     RowBox[{"0", "<", "x", "<", "1"}]}], ",", 
    RowBox[{
     RowBox[{"t", ">", "0"}], ";"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3c760ab8-9b85-f14b-86bd-85dbf310da88"]
}], "Text",
 CellChangeTimes->{{4.0031933339404697`*^9, 4.003193338112501*^9}, 
   4.003202219293558*^9, {4.0032024008893566`*^9, 
   4.0032024841375523`*^9}},ExpressionUUID->"731b53a2-e91e-964a-b3be-\
d41d3fbc6aa1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqn", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "t"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "==", 
      RowBox[{"4", "*", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "0"}], "]"}], "==", 
      RowBox[{"3", 
       RowBox[{"Sin", "[", "x", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Derivative", "[", 
         RowBox[{"0", ",", "1"}], "]"}], "[", "u", "]"}], "[", 
       RowBox[{"x", ",", "0"}], "]"}], "==", 
      SuperscriptBox["x", "4"]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{"eqn", ",", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", "\"\<x\>\"", ",", "\"\<u\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Ticks", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "3"}], ",", "0"}], "}"}]}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.0031933671701584`*^9, 4.0031936152532597`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"2ef5b269-de83-4442-9c7c-50bfe0f28158"],

