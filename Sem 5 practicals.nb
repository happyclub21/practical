Cell[TextData[{
 "Question 3 :\nFind the traffic density \[Rho](x,t) satisfying ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Rho]", "t"], "+", 
      RowBox[{"2", 
       SubscriptBox["\[Rho]", "x"]}]}], "=", "0"}], ","}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "194c0df0-c806-204d-a40d-14b54103243d"],
 " with  initial condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Rho]", "0"], "(", "x", ")"}], "=", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      SuperscriptBox["x", "2"]}], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "06386cb2-99a4-5241-9aca-ecc5bb33acdb"],
 " .\nPlot the characteristics base curves and the traffic density function."
}], "Text",
 CellChangeTimes->{{4.003195554762556*^9, 4.0031955586958904`*^9}, {
  4.0032044579431*^9, 4.0032044958082027`*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"8d75d614-0225-9149-8adb-29fc49e7edc4"],

Cell[TextData[StyleBox["The  Characteristic base curves for the given initial \
value problem are given by : ",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{4.003195614395628*^9, 4.0031956247457047`*^9}},
 FontSize->12,ExpressionUUID->"893d44a6-1aa6-404e-871c-3ef70a357d89"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"charBaseCurves3", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"x", "'"}], "[", "t", "]"}], "==", "2"}], ",", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "==", "x0"}]}], "}"}], ",", 
    RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}]}]], "Input",
 CellChangeTimes->{{4.0031956377709885`*^9, 4.0031956449631767`*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"95665a59-c1e5-d049-bc2c-b8abe14cfea9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{"2", " ", "t"}], "+", "x0"}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{4.0031956481912346`*^9},
 CellLabel->"Out[35]=",ExpressionUUID->"d863bd95-a847-304a-9c9d-102d9bde9c3f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"tab", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], "/.", 
      RowBox[{"charBaseCurves3", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "/.", 
     RowBox[{"{", 
      RowBox[{"x0", "->", "k"}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "1", ",", "5", ",", "1"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", "tab", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"Thickness", "[", "0.01", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"tab", "[", 
       RowBox[{"[", "i", "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "5"}], "}"}]}], "]"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "->", "\"\<Characteristic base curves\>\""}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{4.003195674025528*^9, 4.003195691722151*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"c34ecf10-38bd-cd49-9d62-64abbff19a04"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"1", "+", 
    RowBox[{"2", " ", "t"}]}], ",", 
   RowBox[{"2", "+", 
    RowBox[{"2", " ", "t"}]}], ",", 
   RowBox[{"3", "+", 
    RowBox[{"2", " ", "t"}]}], ",", 
   RowBox[{"4", "+", 
    RowBox[{"2", " ", "t"}]}], ",", 
   RowBox[{"5", "+", 
    RowBox[{"2", " ", "t"}]}]}], "}"}]], "Output",
 CellChangeTimes->{4.003195699672941*^9},
 CellLabel->"Out[36]=",ExpressionUUID->"3016a221-3303-a345-8b6c-3bac55555e80"],

