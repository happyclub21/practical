Cell[TextData[{
 "Question 8 \nSolve the Cauchy problem ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["u", "x"], "+", 
      RowBox[{"3", 
       SubscriptBox["u", "y"]}]}], "=", "u"}], ",", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"x", ",", "y"}], ")"}], "=", 
     RowBox[{
      RowBox[{"Cos", " ", "x", " ", "on", " ", "y"}], "=", "x", " "}]}]}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "53e19265-b799-014e-96da-9517827d19af"],
 "and plot the solution also."
}], "Text",
 CellChangeTimes->{{4.0031065666634464`*^9, 4.003106569955021*^9}, {
  4.0031988029641304`*^9, 4.0031988372824745`*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"bd99cbb6-8acc-f144-917f-9783823f1d53"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pde", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "+", 
     RowBox[{"3", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}]}], "==", 
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pde", ",", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "x"}], "]"}], "==", 
        RowBox[{"Cos", "[", "x", "]"}]}]}], "}"}], ",", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Solution of given cauchy problem is : \>\"", ",", "sol"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "/.", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.003106578443142*^9, 4.0031066314671574`*^9}},
 CellLabel->"In[72]:=",ExpressionUUID->"64c76c02-7033-1441-b94a-4692be0ad02b"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Solution of given cauchy problem is : \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "\[Rule]", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["x", "2"]}], "+", 
         FractionBox["y", "2"]}]], " ", 
       RowBox[{"Cos", "[", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"3", " ", "x"}], "-", "y"}], ")"}]}], "]"}]}]}], "}"}], 
    "}"}]}],
  SequenceForm[
  "Solution of given cauchy problem is : ", {{$CellContext`u[$CellContext`x, \
$CellContext`y] -> 
     E^(Rational[-1, 2] $CellContext`x + Rational[1, 2] $CellContext`y) 
      Cos[Rational[1, 2] (3 $CellContext`x - $CellContext`y)]}}],
  Editable->False]], "Print",
 CellChangeTimes->{4.003106633657028*^9, 4.0032052364776382`*^9},
 CellLabel->
  "During evaluation of \
In[72]:=",ExpressionUUID->"f672779d-f4c5-9743-858a-860e059d8f10"],

