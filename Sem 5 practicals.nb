  4.0032011477459736`*^9, 4.0032011728489494`*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"b9b73588-68a1-6a40-aa31-a01eb0321ea6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "==", 
    RowBox[{"16", "*", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}]}], ",", 
   RowBox[{"u", "[", 
    RowBox[{"x", ",", "t"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "t"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"da", "[", 
   RowBox[{"c_", ",", "f_", ",", "g_", ",", "x_", ",", "t_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"1", "/", "2"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"f", "/.", 
        RowBox[{"x", "->", 
         RowBox[{"x", "+", 
          RowBox[{"c", "*", "t"}]}]}]}], ")"}], "+", 
      RowBox[{"(", 
       RowBox[{"f", "/.", 
        RowBox[{"x", "->", 
         RowBox[{"x", "-", 
          RowBox[{"c", "*", "t"}]}]}]}], ")"}]}], ")"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", "*", "c"}], ")"}]}], ")"}], "*", 
    RowBox[{"Integrate", "[", 
     RowBox[{"g", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"x", "-", 
         RowBox[{"c", "*", "t"}]}], ",", 
        RowBox[{"x", "+", 
         RowBox[{"c", "*", "t"}]}]}], "}"}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"da", "[", 
  RowBox[{"4", ",", 
   RowBox[{"Cos", "[", "x", "]"}], ",", 
   RowBox[{"x", "*", 
    RowBox[{"Exp", "[", "x", "]"}]}], ",", "x", ",", "t"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{"%", ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "1", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"t", ",", "x", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.00311058335425*^9, 4.003110619707407*^9}},
 CellLabel->
  "In[110]:=",ExpressionUUID->"4ecdd4ab-35aa-e94e-bb9d-a7f84d73b8a5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{
      TemplateBox[{"1"},
       "C"], "[", 
      RowBox[{"t", "-", 
       FractionBox["x", "4"]}], "]"}], "+", 
     RowBox[{
      TemplateBox[{"2"},
       "C"], "[", 
      RowBox[{"t", "+", 
       FractionBox["x", "4"]}], "]"}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{4.003110632038332*^9, 4.003110762837946*^9},
 CellLabel->
  "Out[110]=",ExpressionUUID->"4de3624f-aeca-7449-bc76-842df0e0418c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox["1", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{"4", " ", "t"}], "-", "x"}], "]"}], "+", 
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{"4", " ", "t"}], "+", "x"}], "]"}]}], ")"}]}], "+", 
  RowBox[{
   FractionBox["1", "4"], " ", 
   SuperscriptBox["\[ExponentialE]", "x"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"4", " ", "t", " ", 
      RowBox[{"Cosh", "[", 
       RowBox[{"4", " ", "t"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "x"}], ")"}], " ", 
      RowBox[{"Sinh", "[", 
       RowBox[{"4", " ", "t"}], "]"}]}]}], ")"}]}]}]], "Output",
 CellChangeTimes->{4.003110632038332*^9, 4.0031107630033436`*^9},
 CellLabel->
  "Out[112]=",ExpressionUUID->"7d92f00f-7db9-9d4e-8f2c-b2935a2fd34e"],

