Cell[TextData[{
 "Question 6 \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["u", "tt"], "-", 
      RowBox[{"4", 
       SubscriptBox["u", "xx"]}]}], "=", "0"}], ",", " ", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", "0"}], ",", 
    RowBox[{
     RowBox[{
      SubscriptBox["u", "t"], "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", "x"}], ",", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["u", "x"], "(", 
      RowBox[{"0", ",", "t"}], ")"}], " ", "=", 
     RowBox[{"0", ":", " ", 
      RowBox[{"0", "<", "x", "<", "1"}]}]}], ",", 
    RowBox[{
     RowBox[{"t", ">", "0"}], ";"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "615806c9-65f1-0541-be03-15be5b1c11ca"]
}], "Text",
