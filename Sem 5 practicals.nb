Cell[TextData[{
 "Question 1 \nFind general solution of partial differential equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"x", 
      RowBox[{
       SubscriptBox["\[PartialD]", "x"], 
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y"}], "]"}]}]}], "+", 
     RowBox[{"y", 
      RowBox[{
       SubscriptBox["\[PartialD]", "y"], 
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y"}], "]"}]}]}]}], "=", 
    RowBox[{"2", "xy"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bb5872be-ec4f-7043-b92b-14c34941953c"]
}], "Text",
