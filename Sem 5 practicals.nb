Cell[TextData[{
 "Question 3 \nPlot the characteristics for the first order PDE : ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["xu", "x"], "+", 
     SubscriptBox["yu", "y"]}], "=", 
    RowBox[{"2", "xy"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "52a16dbd-0284-2748-b3f4-af0f90d903a1"]
}], "Text",
 CellChangeTimes->{{4.0031050440086823`*^9, 4.0031050467567883`*^9}, {
  4.0031075724577255`*^9, 4.003107577834408*^9}, {4.0031991734060936`*^9, 
  4.0031991905517654`*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"cdacd609-383e-ac4f-9834-ee47742faa10"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pde", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}]}], "+", 
     RowBox[{"y", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}]}], "==", 
    RowBox[{"2", "*", "x", "*", "y"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{"pde", ",", 
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.003104611409994*^9, 4.003104612982485*^9}, {
  4.003107590912716*^9, 4.003107613500065*^9}},
 CellLabel->"In[89]:=",ExpressionUUID->"eafad0c9-bb2d-3947-8796-9abcd27668fc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{"x", " ", "y"}], "+", 
     RowBox[{
      TemplateBox[{"1"},
       "C"], "[", 
      FractionBox["y", "x"], "]"}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{4.0031076193691807`*^9, 4.0032052637127476`*^9},
 CellLabel->"Out[90]=",ExpressionUUID->"b9fd482d-6f7d-b04b-8be9-0cef57ad696a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f0", "=", 
   RowBox[{"ContourPlot3D", "[", 
    RowBox[{
     RowBox[{"u", "-", 
      RowBox[{"x", "*", "y"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"u", ",", "0", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"y", ",", "0", ",", "2"}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "250"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<y\>\"", ",", "\"\<u\>\""}], "}"}]}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f1", "=", 
   RowBox[{"ContourPlot3D", "[", 
    RowBox[{
     RowBox[{"y", "/", "x"}], ",", 
     RowBox[{"{", 
      RowBox[{"u", ",", 
       RowBox[{"-", "1"}], ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0.1", ",", "0.5"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "1"}], ",", "2"}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "250"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<y\>\"", ",", "\"\<u\>\""}], "}"}]}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"f0", ",", "f1"}], "]"}]}], "Input",
 CellChangeTimes->{{4.0031076626794987`*^9, 4.0031077247295704`*^9}},
 CellLabel->"In[67]:=",ExpressionUUID->"b420c817-e140-8b49-b8a2-98348cea692f"],

