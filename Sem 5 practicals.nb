Cell[TextData[{
 "Question 5 \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["u", "tt"], "=", 
     RowBox[{"4", 
      SubscriptBox["u", "xx"]}]}], ",", " ", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", 
     RowBox[{"Cosh", "[", "x", "]"}]}], ",", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["u", "t"], "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", 
     RowBox[{"2", "x"}]}], ",", " ", 
    RowBox[{"x", "\[Element]", "R"}], " ", ",", 
    RowBox[{"t", ">", "0"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2f02d2db-aa77-464d-b61b-638f016a61c3"]
}], "Text",
 CellChangeTimes->{{4.003110350700491*^9, 4.0031103554020004`*^9}, {
  4.003201067109377*^9, 4.003201087540592*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"aa959c30-265b-7244-8941-77889b87165c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "==", 
    RowBox[{"4", "*", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}]}], ",", 
   RowBox[{"u", "[", 
    RowBox[{"x", ",", "t"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "t"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"da", "[", 
   RowBox[{"c_", ",", "f_", ",", "g_", ",", "x_", ",", "t_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"1", "/", "2"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"f", "/.", 
        RowBox[{"x", "->", 
         RowBox[{"x", "+", 
          RowBox[{"c", "*", "t"}]}]}]}], ")"}], "+", 
      RowBox[{"(", 
       RowBox[{"f", "/.", 
        RowBox[{"x", "->", 
         RowBox[{"x", "-", 
          RowBox[{"c", "*", "t"}]}]}]}], ")"}]}], ")"}]}], "+", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "c"}], ")"}]}], "*", 
    RowBox[{"Integrate", "[", 
     RowBox[{"g", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"x", "-", 
         RowBox[{"c", "*", "t"}]}], ",", 
        RowBox[{"x", "+", 
         RowBox[{"c", "*", "t"}]}]}], "}"}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"da", "[", 
  RowBox[{"2", ",", 
   RowBox[{"Cosh", "[", "x", "]"}], ",", 
   RowBox[{"2", "x"}], ",", "x", ",", "t"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{"%", ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "1", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"t", ",", "x", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.003110362523844*^9, 4.003110397414116*^9}},
 CellLabel->"In[98]:=",ExpressionUUID->"c9c5c932-e5a3-d44e-af75-145c20a8b378"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{
      TemplateBox[{"1"},
       "C"], "[", 
      RowBox[{"t", "-", 
       FractionBox["x", "2"]}], "]"}], "+", 
     RowBox[{
      TemplateBox[{"2"},
       "C"], "[", 
      RowBox[{"t", "+", 
       FractionBox["x", "2"]}], "]"}]}]}], "}"}], "}"}]], "Output",
