             RowBox[{#, ",", #2, ",", #3, ",", #4}], "}"}], ",", 
           RowBox[{"LegendMarkers", "\[Rule]", "None"}], ",", 
           RowBox[{"LabelStyle", "\[Rule]", 
             RowBox[{"{", "}"}]}], ",", 
           RowBox[{"LegendLayout", "\[Rule]", "\"Column\""}]}], "]"}]& ), 
      Editable -> True], TraditionalForm], TraditionalForm]},
  "Legended",
  DisplayFunction->(GridBox[{{
      TagBox[
       ItemBox[
        PaneBox[
         TagBox[#, "SkipImageSizeLevel"], Alignment -> {Center, Baseline}, 
         BaselinePosition -> Baseline], DefaultBaseStyle -> "Labeled"], 
       "SkipImageSizeLevel"], 
      ItemBox[#2, DefaultBaseStyle -> "LabeledLabel"]}}, 
    GridBoxAlignment -> {"Columns" -> {{Center}}, "Rows" -> {{Center}}}, 
    AutoDelete -> False, GridBoxItemSize -> Automatic, 
    BaselinePosition -> {1, 1}]& ),
  Editable->True,
  InterpretationFunction->(RowBox[{"Legended", "[", 
     RowBox[{#, ",", 
       RowBox[{"Placed", "[", 
         RowBox[{#2, ",", "After"}], "]"}]}], "]"}]& )]], "Output",
 CellChangeTimes->{4.0031969612411747`*^9},
 CellLabel->"Out[51]=",ExpressionUUID->"1b459cf7-f570-a84b-908a-b5ffa0f552a0"]
}, Open  ]],

Cell[TextData[StyleBox["The traffic density function \[Rho](x,t) or the \
solution for the given initial value problem are given by: ",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{
  4.003196979909857*^9},ExpressionUUID->"8e927ce0-bd4a-b34d-aacd-\
917c4ea352a6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqn5", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "+", 
     RowBox[{
      SuperscriptBox["t", "2"], "*", 
      RowBox[{"Cos", "[", "t", "]"}], "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "t"}], "]"}], ",", "x"}], "]"}]}]}], "==", "5"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol5", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eqn5", ",", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "0"}], "]"}], "==", 
       RowBox[{"Exp", "[", "x", "]"}]}]}], "}"}], ",", 
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "t"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.003197002848255*^9, 4.003197063564783*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"e1ba9ec0-d22b-a347-bc11-f281faa45e7c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "\[Rule]", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", "t", " ", 
        RowBox[{"Cos", "[", "t", "]"}]}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "2"}], "+", 
          SuperscriptBox["t", "2"]}], ")"}], " ", 
        RowBox[{"Sin", "[", "t", "]"}]}]}]], " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", "x"], "+", 
       RowBox[{"5", " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"2", " ", "t", " ", 
           RowBox[{"Cos", "[", "t", "]"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "2"}], "+", 
             SuperscriptBox["t", "2"]}], ")"}], " ", 
           RowBox[{"Sin", "[", "t", "]"}]}]}]], " ", "t"}]}], ")"}]}]}], 
   "}"}], "}"}]], "Output",
 CellChangeTimes->{4.003197069669567*^9},
 CellLabel->"Out[53]=",ExpressionUUID->"c2ea4211-a480-2945-9243-4cdf5ec11949"]
}, Open  ]],

Cell[TextData[StyleBox["Hence \[Rho](x,t) is the traffic density function of \
the given initial value problem.",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{4.003197085044014*^9, 
  4.003197102550125*^9}},ExpressionUUID->"93edda54-05e1-3042-9932-\
bae51d0a6c99"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "sol5"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Traffic density function\>\""}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{4.0031971209567966`*^9, 4.003197131948292*^9}},
 CellLabel->"In[54]:=",ExpressionUUID->"ab115efa-6e69-6b48-800f-369defda3327"],

