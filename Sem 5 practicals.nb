Cell[TextData[{
 "Question 2\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["u", "t"], "=", 
     RowBox[{"4", 
      SubscriptBox["u", "xx"]}]}], ",", " ", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", 
     RowBox[{
      SuperscriptBox["x", "2"], "-", 
      SuperscriptBox["x", "3"]}]}], ",", " ", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"0", ",", "t"}], ")"}], "=", "0"}], ",", " ", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"1", ",", "t"}], ")"}], "=", "0"}], ",", " ", 
    RowBox[{"0", "<", "x", "<", "1"}], ",", " ", 
    RowBox[{"t", ">", "0"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ded2b9ea-6058-ac40-b933-048b6277100b"]
}], "Text",
 CellChangeTimes->{{4.0031113522911987`*^9, 4.003111362390175*^9}, {
  4.003111405183975*^9, 4.0031114176038647`*^9}, {4.003202051295244*^9, 
  4.0032020935718155`*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"6b05f8fc-ea50-d841-9714-429e7e32f730"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqn", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "==", 
      RowBox[{"4", "*", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "0"}], "]"}], "==", 
      RowBox[{
       SuperscriptBox["x", "2"], "-", 
       SuperscriptBox["x", "3"]}]}], ",", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"0", ",", "t"}], "]"}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"1", ",", "t"}], "]"}], "==", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{"eqn", ",", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "5"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "/.", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "5"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"x", ",", "t", ",", "u"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.0031114286052895`*^9, 4.003111489367325*^9}},
 CellLabel->
  "In[130]:=",ExpressionUUID->"ec104ab8-c031-fa42-9b32-1f02e07bf130"],

