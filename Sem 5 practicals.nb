      RowBox[{"2", " ", 
       SuperscriptBox["t", "3"]}]}], ")"}]}], ",", 
   RowBox[{
    FractionBox["1", "3"], " ", 
    RowBox[{"(", 
     RowBox[{"36", "+", 
      RowBox[{"2", " ", 
       SuperscriptBox["t", "3"]}]}], ")"}]}], ",", 
   RowBox[{
    FractionBox["1", "3"], " ", 
    RowBox[{"(", 
     RowBox[{"45", "+", 
      RowBox[{"2", " ", 
       SuperscriptBox["t", "3"]}]}], ")"}]}]}], "}"}]], "Output",
 CellChangeTimes->{4.0031960227771816`*^9},
 CellLabel->"Out[44]=",ExpressionUUID->"300e74fa-6137-c943-a085-3724d23f1f55"],

