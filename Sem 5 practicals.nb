Cell[TextData[{
 "Question 4 \nPlot the characteristics for the first order PDE : ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["xu", "x"], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "+", "y"}], ")"}], 
      SubscriptBox["u", "y"]}]}], "=", 
    RowBox[{"u", "+", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fb1868da-b9e1-c942-b509-70e51f9d90e6"]
}], "Text",
 CellChangeTimes->{{4.003107752651211*^9, 4.0031077573788147`*^9}, {
  4.0031992026823616`*^9, 4.0031992222328606`*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"781c3f73-8ae3-354d-ab04-d9bbed2477ed"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pde", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "+", "y"}], ")"}], "*", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}]}], "==", 
    RowBox[{
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "y"}], "]"}], "+", "1"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sol", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{"pde", ",", 
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{4.003107768088398*^9, 4.003107786986536*^9}},
 CellLabel->"In[70]:=",ExpressionUUID->"9c4a48a3-0144-ee40-985d-8c1f0a749d91"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     RowBox[{"x", " ", 
      RowBox[{
       TemplateBox[{"1"},
        "C"], "[", 
       RowBox[{
        FractionBox["y", "x"], "-", 
        RowBox[{"Log", "[", "x", "]"}]}], "]"}]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{4.003107797452919*^9},
 CellLabel->"Out[71]=",ExpressionUUID->"538e83f5-8b49-fa48-8260-649333b95774"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f0", "=", 
   RowBox[{"ContourPlot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"u", "+", "1"}], ")"}], "/", "x"}], ",", 
     RowBox[{"{", 
      RowBox[{"u", ",", 
       RowBox[{"-", "1"}], ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0.1", ",", "0.5"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"y", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "250"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x-axis\>\"", ",", "\"\<y-axis\>\"", 
        ",", "\"\<u-axis\>\""}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f1", "=", 
   RowBox[{"ContourPlot3D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"y", "-", 
        RowBox[{"x", "*", 
         RowBox[{"Log", "[", "x", "]"}]}]}], ")"}], "/", "x"}], ",", 
     RowBox[{"{", 
      RowBox[{"u", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0.1", ",", "0.5"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"y", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "250"}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x-axis\>\"", ",", "\"\<y-axis\>\"", 
        ",", "\"\<u-axis\>\""}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"f0", ",", "f1"}], "]"}]}], "Input",
 CellChangeTimes->{{4.003107830163805*^9, 4.00310793731995*^9}},
 CellLabel->"In[72]:=",ExpressionUUID->"8ccd9aec-a925-c94d-9eee-731d98b174f8"],

