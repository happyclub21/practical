Cell[TextData[{
 "Question 4 \nFind the traffic density \[Rho](x,t) satisfying ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Rho]", "t"], "+", 
      RowBox[{"2", 
       SuperscriptBox["t", "2"], "*", 
       SubscriptBox["\[Rho]", "x"]}]}], "=", 
     SuperscriptBox["\[Rho]", "2"]}], ","}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "31d5af00-432e-1548-9f44-5f84ea4cc04f"],
 " with  initial condition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Rho]", "0"], "(", "x", ")"}], "=", 
    RowBox[{
     SuperscriptBox["Sin", "2"], "(", "x", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3efde976-135d-2d4d-844e-44089c284186"],
 " .\nPlot the characteristics base curves and the traffic density function."
}], "Text",
 CellChangeTimes->{{4.003195898923504*^9, 4.0031959049095573`*^9}, {
  4.003204520107046*^9, 4.0032045731878567`*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"01057570-ee5d-824a-b9ae-2861db8b3686"],

Cell[TextData[StyleBox["The  Characteristic base curves for the given initial \
value problem are given by : ",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{
  4.0031959217774277`*^9},ExpressionUUID->"a6eacbc7-852d-9648-ae38-\
5f9ed74af167"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"charBaseCurves4", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
       RowBox[{"2", "*", 
        SuperscriptBox["t", "2"]}]}], ",", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "==", "x0"}]}], "}"}], ",", 
    RowBox[{"x", "[", "t", "]"}], ",", "t"}], "]"}]}]], "Input",
 CellChangeTimes->{{4.003195944529604*^9, 4.003195961253605*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"92c3c8c7-37bb-484f-8626-ddd46264868f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
    RowBox[{
     FractionBox["1", "3"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        SuperscriptBox["t", "3"]}], "+", 
       RowBox[{"3", " ", "x0"}]}], ")"}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{4.003195967991398*^9},
 CellLabel->"Out[41]=",ExpressionUUID->"12731956-e9a2-374c-af90-415433e3e88b"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"tab", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], "/.", 
      RowBox[{"charBaseCurves4", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "/.", 
     RowBox[{"{", 
      RowBox[{"x0", "->", "k"}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "3", ",", "15", ",", "3"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", "tab", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"Thickness", "[", "0.01", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"tab", "[", 
       RowBox[{"[", "i", "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "5"}], "}"}]}], "]"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "->", "\"\<Characteristic base curves\>\""}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{4.00319599318326*^9, 4.003196016768709*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"676120f6-cbbd-fa44-8f5c-de6cbc66793f"],

