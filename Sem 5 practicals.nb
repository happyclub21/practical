Cell[TextData[{
 StyleBox["Practical 4 ",
  FontFamily->"Britannic",
  FontSize->36,
  FontVariations->{"Underline"->True}],
 "\n",
 StyleBox["Solution of vibrating string problem using \
D\[CloseCurlyQuote]Alembert formula with initial conditions.\n",
  FontSize->18],
 StyleBox["Find the D\[CloseCurlyQuote]Almbert solution of the wave equation ",
  FontSize->24,
  FontColor->RGBColor[1, 0, 1]],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "tt"], "=", 
    RowBox[{
     SuperscriptBox["c", "2"], 
     SubscriptBox["u", "xx"], " "}]}], TraditionalForm]],
  FormatType->TraditionalForm,
  FontSize->24,
  FontColor->RGBColor[1, 0, 1],ExpressionUUID->
  "361fcee5-3d90-964d-a5f9-30d3a5067494"],
 StyleBox[" subjected to u(x,0)=f(x) , ",
  FontSize->24,
  FontColor->RGBColor[1, 0, 1]],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["u", "t"], "(", 
     RowBox[{"x", ",", "0"}], ")"}], "=", 
    RowBox[{
     RowBox[{"g", "(", "x", ")"}], " ", ":", " ", "x"}]}], TraditionalForm]],
  FormatType->TraditionalForm,
  FontSize->24,
  FontColor->RGBColor[1, 0, 1],ExpressionUUID->
  "afeb6dc4-46ab-384f-b245-89d6b968a2fd"],
 StyleBox["\[Element] R, t>0 ",
  FontSize->24,
  FontColor->RGBColor[1, 0, 1]]
}], "Text",
 CellChangeTimes->{{4.0031080928382263`*^9, 4.003108145581524*^9}, {
  4.0032007083892727`*^9, 
  4.003200861616144*^9}},ExpressionUUID->"6535ab0a-62c2-9f46-b7c5-\
5b425d7e1e64"],

Cell[TextData[{
 "Question 1\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["u", "tt"], "=", 
     SubscriptBox["u", "xx"]}], ",", " ", 
    RowBox[{
     RowBox[{"u", "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", "0"}], ",", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["u", "t"], "(", 
      RowBox[{"x", ",", "0"}], ")"}], "=", 
     SuperscriptBox["x", "2"]}], ",", " ", 
    RowBox[{"x", "\[Element]", "R"}], " ", ",", 
    RowBox[{"t", ">", "0"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0a4ec015-bd2f-6043-954e-06c012fe8516"]
}], "Text",
 CellChangeTimes->{{4.003109605580988*^9, 4.0031096079088*^9}, {
  4.003200870100256*^9, 4.0032009435747833`*^9}},
 FontColor->RGBColor[
  0.5, 0, 0.5],ExpressionUUID->"1baee5c4-ddee-204e-ad1c-f9fd4e773a5e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "==", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}], ",", 
   RowBox[{"u", "[", 
    RowBox[{"x", ",", "t"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "t"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{4.003109612613348*^9, 4.003109687625925*^9}},
 CellLabel->"In[80]:=",ExpressionUUID->"24519328-6406-2547-b321-278c06bc5bdb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{
      TemplateBox[{"1"},
       "C"], "[", 
      RowBox[{"t", "-", "x"}], "]"}], "+", 
     RowBox[{
      TemplateBox[{"2"},
       "C"], "[", 
      RowBox[{"t", "+", "x"}], "]"}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{4.0031096896780777`*^9},
 CellLabel->"Out[80]=",ExpressionUUID->"931b6a24-83e0-8945-9441-ba1b3198c83d"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"da", "[", 
   RowBox[{"c_", ",", "f_", ",", "g_", ",", "x_", ",", "t_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"1", "/", "2"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"f", "/.", 
        RowBox[{"x", "->", 
         RowBox[{"x", "+", 
          RowBox[{"c", "*", "t"}]}]}]}], ")"}], "+", 
      RowBox[{"(", 
       RowBox[{"f", "/.", 
        RowBox[{"x", "->", 
         RowBox[{"x", "-", 
          RowBox[{"c", "*", "t"}]}]}]}], ")"}]}], ")"}]}], "+", 
   RowBox[{
